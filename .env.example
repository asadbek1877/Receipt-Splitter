# Environment variables for splitter-backend

# Server
PORT=3001

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Database URL (set by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Product image search cache
# Preferred provider: Google Custom Search image search.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Optional fallback provider.
UNSPLASH_ACCESS_KEY=

IMAGE_SEARCH_TIMEOUT_MS=5000
PRODUCT_IMAGE_BATCH_LIMIT=50

# Admin panel (disabled unless BOTH are set; there is no default password)
# Comma-separated numeric user ids allowed to use /admin routes
ADMIN_USER_IDS=
# Strong secret required in the x-admin-password header
ADMIN_PANEL_PASSWORD=

# SMTP (required for /auth/register/send-code and /auth/forgot-password;
# without it these endpoints return 503 instead of exposing codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
